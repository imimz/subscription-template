# Copy to .env, edit, then run `bun run build`. Every value is optional.

# Default page language: fa, en, ru or zh.
VITE_FALLBACK_LANGUAGE=fa

# Only for local development (`bun run dev`): the panel to load data from.
# Leave empty in production so the page uses the domain it is served from.
VITE_PANEL_DOMAIN=

# Main color for the light/dark themes and corner radius.
# Default blue: oklch(0.48 0.11 250) / oklch(0.60 0.12 250). Gold: oklch(0.62 0.13 75) / oklch(0.80 0.14 85).
VITE_PRIMARY_COLOR_LIGHT=oklch(0.48 0.11 250)
VITE_PRIMARY_COLOR_DARK=oklch(0.60 0.12 250)
VITE_BORDER_RADIUS=0.65rem

# Telegram bot link shown on the emergency charge card, e.g. https://t.me/your_bot
VITE_TELEGRAM_BOT_URL=

# Emergency charge (optional): URL of the emergency-charge service (see emergency-charge/README.md).
# Leave empty to hide the emergency charge card.
VITE_EMERGENCY_CHARGE_URL=
# Keep these in sync with CHARGE_MB / LOW_TRAFFIC_THRESHOLD_MB of the service.
VITE_EMERGENCY_CHARGE_MB=500
VITE_EMERGENCY_CHARGE_THRESHOLD_MB=500
