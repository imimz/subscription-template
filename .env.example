VITE_PANEL_DOMAIN=https://example.com
VITE_FALLBACK_LANGUAGE=en
VITE_PRIMARY_COLOR_LIGHT=oklch(0.48 0.11 250)
VITE_PRIMARY_COLOR_DARK=oklch(0.60 0.12 250)
VITE_BORDER_RADIUS=0.65rem

# Emergency charge (optional): URL of the emergency-charge service (see emergency-charge/README.md).
# Leave empty to hide the emergency charge card.
VITE_EMERGENCY_CHARGE_URL=
# Keep these in sync with CHARGE_MB / LOW_TRAFFIC_THRESHOLD_MB of the service.
VITE_EMERGENCY_CHARGE_MB=500
VITE_EMERGENCY_CHARGE_THRESHOLD_MB=500
# Telegram bot link shown next to the emergency charge button, e.g. https://t.me/your_bot
VITE_TELEGRAM_BOT_URL=
