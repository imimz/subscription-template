[Unit]
Description=PasarGuard subscription emergency charge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/emergency-charge
ExecStart=/usr/bin/python3 /opt/emergency-charge/server.py
Environment=ENV_FILE=/opt/emergency-charge/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
