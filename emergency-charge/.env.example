# Panel address as reachable from this server (must match its TLS certificate).
PANEL_URL=https://panel.example.com:8000
# Subscription path of the panel (SUBSCRIPTION_PATH in the panel's .env, default "sub").
SUB_PATH=sub

# Admin credentials: either an API key (Panel → API Keys) or an admin username/password.
# The admin must be allowed to read and update users.
PANEL_API_KEY=
PANEL_ADMIN_USERNAME=
PANEL_ADMIN_PASSWORD=
# Set to false only if the panel uses a self-signed certificate.
PANEL_VERIFY_TLS=true

# Free traffic added per claim (MB), and the remaining-traffic level under which it can be claimed.
CHARGE_MB=500
LOW_TRAFFIC_THRESHOLD_MB=500

# Where this service listens. Use 127.0.0.1 behind a reverse proxy (nginx/caddy),
# or 0.0.0.0 together with SSL_CERT_FILE/SSL_KEY_FILE to serve HTTPS directly.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8765
ROUTE_PATH=/emergency-charge
SSL_CERT_FILE=
SSL_KEY_FILE=

# Origin(s) of the subscription page, comma separated (scheme + host + port, no path).
ALLOWED_ORIGINS=https://panel.example.com:8000

# true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=10

# SQLite file that remembers who already claimed (defaults to claims.db next to server.py).
DB_PATH=
LOG_LEVEL=INFO
